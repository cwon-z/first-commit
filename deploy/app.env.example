# first-commit — accounts backend configuration.
#
# Copy to app.env next to docker-compose.yml, fill in, and keep it out of git:
# FC_SMTP_URL is a live credential.  chmod 600 app.env
#
# Every value here is configuration rather than a secret except FC_SMTP_URL,
# which is why the rest can be read in public without giving anything away.

# Who owns the course. Ownership opens /admin.html and everyone's progress with
# it. SET THIS BEFORE THE SERVER IS REACHABLE: without it, the first account to
# register becomes the owner, and on a public host that is a race a stranger
# can win. Comma-separated for more than one.
FC_OWNER_EMAILS=you@example.com

# Public origin, used to build the links inside verification and reset email.
# No trailing slash.
FC_BASE_URL=https://example.com

# 1 behind HTTPS. Without it the session cookie is sent over plain http too.
FC_SECURE_COOKIES=1

# How many reverse proxies sit in front of this server. Required behind
# nginx/Caddy: at 0 every visitor shares one rate-limit bucket, so one attacker
# locks out everybody. Count the entries that actually arrive in
# X-Forwarded-For — see the note about Cloudflare in README.md, because the
# obvious answer is wrong behind a tunnel.
FC_TRUST_PROXY=1

# 1 means unconfirmed accounts can read the course but cannot save progress.
# Only turn this on once mail actually sends, or nobody can ever confirm.
FC_REQUIRE_VERIFICATION=1

# Envelope sender. If your relay restricts which addresses you may send as,
# this must match exactly or every send is refused.
FC_MAIL_FROM=course@example.com

# Ceiling on outbound mail for the whole instance, per hour. Sign-up mails
# whatever address is typed, so this is what stops an open course being turned
# into a machine for delivering mail to strangers from your domain.
FC_MAIL_MAX_PER_HOUR=100

# Real submission over TLS. Omit entirely and mail is written to data/outbox/
# instead of being sent — the right setting on a laptop, wrong in public.
# The password must be percent-encoded here: + becomes %2B, / becomes %2F.
# FC_SMTP_URL=smtps://username:percent%2Bencoded%2Fpassword@smtp.example.com:465
